<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         CUSTOM A4 PAPER FORMAT
         Reduces unnecessary top / bottom whitespace
    ========================================================== -->

    <record id="paperformat_nk_salesperson_statement"
            model="report.paperformat">

        <field name="name">Field Salesperson Profit Statement A4</field>

        <field name="default" eval="False"/>

        <field name="format">A4</field>

        <field name="orientation">Portrait</field>

        <field name="margin_top">5</field>

        <field name="margin_bottom">5</field>

        <field name="margin_left">7</field>

        <field name="margin_right">7</field>

        <field name="header_line" eval="False"/>

        <field name="header_spacing">0</field>

        <field name="dpi">90</field>

    </record>


    <!-- =========================================================
         REPORT ACTION
    ========================================================== -->

    <record id="action_report_nk_salesperson_statement"
            model="ir.actions.report">

        <field name="name">Field Salesperson Profit Statement</field>

        <field name="model">nk.salesperson.report.wizard</field>

        <field name="report_type">qweb-pdf</field>

        <field name="report_name">nk_salesperson_sales_login.report_nk_salesperson_statement</field>

        <field name="report_file">nk_salesperson_sales_login.report_nk_salesperson_statement</field>

        <field name="paperformat_id"
               ref="paperformat_nk_salesperson_statement"/>

        <field name="print_report_name">'Profit Statement'</field>

    </record>


    <!-- =========================================================
         REPORT TEMPLATE
    ========================================================== -->

    <template id="report_nk_salesperson_statement">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="doc">

                <t t-set="data"
                   t-value="doc._get_statement_data()"/>


                <div class="page"
                     style="
                        font-family: DejaVu Sans, Arial, sans-serif;
                        font-size: 9px;
                        color: #212529;
                        margin: 0 !important;
                        padding: 0 !important;
                     ">


                    <!-- =================================================
                         CSS
                    ================================================== -->

                    <style type="text/css">

                        .rupee-symbol:before {
                            content: "\20B9";
                            font-family: "DejaVu Sans", Arial, sans-serif;
                        }

                        .money {
                            white-space: nowrap;
                        }

                        table {
                            page-break-inside: auto;
                        }

                        tr {
                            page-break-inside: avoid;
                        }

                        .section-title {
                            color: #1f3c5b;
                            font-size: 11px;
                            margin: 0 0 2px 0;
                            padding: 0;
                            font-weight: bold;
                        }

                    </style>


                    <!-- =================================================
                         HEADER
                    ================================================== -->

                    <div style="
                        border-bottom: 2px solid #1f3c5b;
                        padding-bottom: 4px;
                        margin-bottom: 5px;
                    ">

                        <table style="
                            width: 100%;
                            border: 0;
                            border-collapse: collapse;
                            margin: 0;
                            padding: 0;
                        ">

                            <tr>

                                <td style="
                                    width: 65%;
                                    border: 0;
                                    padding: 0;
                                    vertical-align: top;
                                ">

                                    <h2 style="
                                        margin: 0;
                                        padding: 0;
                                        color: #1f3c5b;
                                        font-size: 18px;
                                        font-weight: bold;
                                    ">
                                        Salesperson Profit Statement
                                    </h2>

                                    <div style="
                                        margin-top: 1px;
                                        color: #6c757d;
                                        font-size: 8px;
                                    ">
                                        Sales &amp; Employee Cost Analysis
                                    </div>

                                </td>


                                <td style="
                                    width: 35%;
                                    border: 0;
                                    padding: 0;
                                    text-align: right;
                                    vertical-align: top;
                                ">

                                    <div style="
                                        font-size: 7px;
                                        color: #6c757d;
                                    ">
                                        REPORT PERIOD
                                    </div>

                                    <strong style="font-size: 9px;">

                                        <span t-out="doc.date_from"
                                              t-options='{"widget": "date"}'/>

                                        -

                                        <span t-out="doc.date_to"
                                              t-options='{"widget": "date"}'/>

                                    </strong>

                                </td>

                            </tr>

                        </table>

                    </div>


                    <!-- =================================================
                         SALESPERSON INFORMATION
                    ================================================== -->

                    <table style="
                        width: 100%;
                        border-collapse: collapse;
                        margin: 0 0 5px 0;
                    ">

                        <tr>

                            <td style="
                                width: 50%;
                                background: #f4f6f8;
                                border: 1px solid #d9dee3;
                                padding: 4px 5px;
                            ">

                                <div style="
                                    font-size: 7px;
                                    color: #6c757d;
                                    text-transform: uppercase;
                                ">
                                    SALESPERSON
                                </div>

                                <strong style="font-size: 10px;">
                                    <span t-out="data['employee'].name"/>
                                </strong>

                            </td>


                            <td style="
                                width: 50%;
                                background: #f4f6f8;
                                border: 1px solid #d9dee3;
                                padding: 4px 5px;
                            ">

                                <div style="
                                    font-size: 7px;
                                    color: #6c757d;
                                    text-transform: uppercase;
                                ">
                                    PERIOD
                                </div>

                                <strong style="font-size: 10px;">

                                    <span t-out="doc.date_from"
                                          t-options='{"widget": "date"}'/>

                                    -

                                    <span t-out="doc.date_to"
                                          t-options='{"widget": "date"}'/>

                                </strong>

                            </td>

                        </tr>

                    </table>


                    <!-- =================================================
                         1. SALES / INVOICE DETAILS
                    ================================================== -->

                    <h3 class="section-title">
                        Sales / Invoice Details
                    </h3>


                    <table style="
                        width: 100%;
                        border-collapse: collapse;
                        margin: 0 0 5px 0;
                    ">

                        <thead>

                            <tr style="
                                background: #1f3c5b;
                                color: #ffffff;
                            ">

                                <th style="
                                    padding: 3px 5px;
                                    text-align: left;
                                ">
                                    Date
                                </th>

                                <th style="
                                    padding: 3px 5px;
                                    text-align: left;
                                ">
                                    Invoice Number
                                </th>

                                <th style="
                                    padding: 3px 5px;
                                    text-align: left;
                                ">
                                    Customer
                                </th>

                                <th style="
                                    padding: 3px 5px;
                                    text-align: right;
                                ">
                                    Invoice Amount
                                </th>

                                <th style="
                                    padding: 3px 5px;
                                    text-align: right;
                                ">
                                    Margin
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <t t-foreach="data['invoices']" t-as="row">

                                <tr style="
                                    border-bottom: 1px solid #dee2e6;
                                ">

                                    <td style="padding: 2px 5px;">

                                        <span t-out="row['date']"
                                              t-options='{"widget": "date"}'/>

                                    </td>


                                    <td style="padding: 2px 5px;">

                                        <span t-out="row['number']"/>

                                    </td>


                                    <td style="padding: 2px 5px;">

                                        <span t-out="row['customer']"/>

                                    </td>


                                    <td style="
                                        padding: 2px 5px;
                                        text-align: right;
                                    ">

                                        <span class="money">
                                            <span class="rupee-symbol"></span>
                                            <span t-out="'%.2f' % row['amount']"/>
                                        </span>

                                    </td>


                                    <td style="
                                        padding: 2px 5px;
                                        text-align: right;
                                    ">

                                        <span class="money">
                                            <span class="rupee-symbol"></span>
                                            <span t-out="'%.2f' % row['margin']"/>
                                        </span>

                                    </td>

                                </tr>

                            </t>


                            <tr t-if="not data['invoices']">

                                <td colspan="5"
                                    style="
                                        padding: 4px;
                                        text-align: center;
                                        color: #6c757d;
                                    ">

                                    No posted invoices in this period.

                                </td>

                            </tr>

                        </tbody>


                        <tfoot>

                            <tr style="
                                background: #f1f3f5;
                                font-weight: bold;
                            ">

                                <td colspan="3"
                                    style="padding: 3px 5px;">

                                    Total Gross Revenue

                                </td>


                                <td style="
                                    padding: 3px 5px;
                                    text-align: right;
                                ">

                                    <span class="money">
                                        <span class="rupee-symbol"></span>
                                        <span t-out="'%.2f' % data['total_invoice']"/>
                                    </span>

                                </td>


                                <td style="
                                    padding: 3px 5px;
                                    text-align: right;
                                ">

                                    <span class="money">
                                        <span class="rupee-symbol"></span>
                                        <span t-out="'%.2f' % data['total_margin']"/>
                                    </span>

                                </td>

                            </tr>

                        </tfoot>

                    </table>


                    <!-- =================================================
                         2. PROFIT SUMMARY
                    ================================================== -->

                    <h3 class="section-title">
                        Profit/Loss Summary
                    </h3>


                    <table style="
                        width: 100%;
                        border-collapse: collapse;
                        margin: 0 0 5px 0;
                    ">

                        <tr>

                            <!-- REVENUE -->

                            <td style="
                                width: 25%;
                                border: 1px solid #d9dee3;
                                padding: 4px 5px;
                                background: #f8f9fa;
                            ">

                                <div style="
                                    font-size: 7px;
                                    color: #6c757d;
                                ">
                                    TOTAL REVENUE
                                </div>

                                <div style="
                                    font-size: 11px;
                                    font-weight: bold;
                                    margin-top: 1px;
                                ">

                                    <span class="money">
                                        <span class="rupee-symbol"></span>
                                        <span t-out="'%.2f' % data['total_invoice']"/>
                                    </span>

                                </div>

                            </td>


                            <!-- MARGIN -->

                            <td style="
                                width: 25%;
                                border: 1px solid #d9dee3;
                                padding: 4px 5px;
                                background: #f8f9fa;
                            ">

                                <div style="
                                    font-size: 7px;
                                    color: #6c757d;
                                ">
                                    GROSS MARGIN
                                </div>

                                <div style="
                                    font-size: 11px;
                                    font-weight: bold;
                                    margin-top: 1px;
                                ">

                                    <span class="money">
                                        <span class="rupee-symbol"></span>
                                        <span t-out="'%.2f' % data['total_margin']"/>
                                    </span>

                                </div>

                            </td>


                            <!-- EXPENSE -->

                            <td style="
                                width: 25%;
                                border: 1px solid #d9dee3;
                                padding: 4px 5px;
                                background: #f8f9fa;
                            ">

                                <div style="
                                    font-size: 7px;
                                    color: #6c757d;
                                ">
                                    TOTAL EXPENSE
                                </div>

                                <div style="
                                    font-size: 11px;
                                    font-weight: bold;
                                    margin-top: 1px;
                                ">

                                    <span class="money">
                                        <span class="rupee-symbol"></span>
                                        <span t-out="'%.2f' % data['total_expense']"/>
                                    </span>

                                </div>

                            </td>


                            <!-- RESULT -->

                            <td style="
                                width: 25%;
                                border: 1px solid #d9dee3;
                                padding: 4px 5px;
                                background: #f8f9fa;
                            ">

                                <div style="
                                    font-size: 7px;
                                    color: #6c757d;
                                ">
                                    NET RESULT
                                </div>

                                <div style="
                                    font-size: 11px;
                                    font-weight: bold;
                                    margin-top: 1px;
                                ">

                                    <t t-if="data['net_profit'] >= 0">

                                        <span style="color: #198754;">
                                            Profit:
                                        </span>

                                    </t>

                                    <t t-else="">

                                        <span style="color: #dc3545;">
                                            Loss:
                                        </span>

                                    </t>

                                    <span class="money">
                                        <span class="rupee-symbol"></span>
                                        <span t-out="'%.2f' % data['net_profit']"/>
                                    </span>

                                </div>

                            </td>

                        </tr>

                    </table>


                    <!-- =================================================
                         3. EMPLOYEE EXPENSE SUMMARY
                    ================================================== -->

                    <h3 class="section-title">
                        Employee Expense Summary
                    </h3>


                    <table style="
                        width: 100%;
                        border-collapse: collapse;
                        margin: 0 0 5px 0;
                    ">

                        <thead>

                            <tr style="
                                background: #1f3c5b;
                                color: #ffffff;
                            ">

                                <th style="
                                    padding: 3px 5px;
                                    text-align: left;
                                ">
                                    Expense Type
                                </th>

                                <th style="
                                    padding: 3px 5px;
                                    text-align: right;
                                ">
                                    Calculation
                                </th>

                                <th style="
                                    padding: 3px 5px;
                                    text-align: right;
                                ">
                                    Amount
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <!-- SALARY -->

                            <tr>

                                <td style="padding: 2px 5px;">
                                    Monthly Salary
                                </td>

                                <td style="
                                    padding: 2px 5px;
                                    text-align: right;
                                ">

                                   
                                   

                                    <span class="money">
                                        <span class="rupee-symbol"></span>
                                        <span t-out="'%.2f' % data['salary_monthly']"/>
                                    </span>

                                </td>

                                <td style="
                                    padding: 2px 5px;
                                    text-align: right;
                                ">

                                    <span class="money">
                                        <span class="rupee-symbol"></span>
                                        <span t-out="'%.2f' % data['salary_total']"/>
                                    </span>

                                </td>

                            </tr>


                            <!-- MOBILE -->

                            <tr style="background: #f8f9fa;">

                                <td style="padding: 2px 5px;">
                                    Mobile Expense
                                </td>

                                <td style="
                                    padding: 2px 5px;
                                    text-align: right;
                                ">

                        
                                   

                                    <span class="money">
                                        <span class="rupee-symbol"></span>
                                        <span t-out="'%.2f' % data['mobile_monthly']"/>
                                    </span>

                                </td>

                                <td style="
                                    padding: 2px 5px;
                                    text-align: right;
                                ">

                                    <span class="money">
                                        <span class="rupee-symbol"></span>
                                        <span t-out="'%.2f' % data['mobile_total']"/>
                                    </span>

                                </td>

                            </tr>


                            <!-- FOOD -->

                            <tr>

                                <td style="padding: 2px 5px;">
                                    Food Expense
                                </td>

                                <td style="
                                    padding: 2px 5px;
                                    text-align: right;
                                ">
                                    Approved Expenses
                                </td>

                                <td style="
                                    padding: 2px 5px;
                                    text-align: right;
                                ">

                                    <span class="money">
                                        <span class="rupee-symbol"></span>
                                        <span t-out="'%.2f' % data['food_total']"/>
                                    </span>

                                </td>

                            </tr>


                            <!-- TRAVEL -->

                            <tr style="background: #f8f9fa;">

                                <td style="padding: 2px 5px;">
                                    Travel Expense
                                </td>

                                <td style="
                                    padding: 2px 5px;
                                    text-align: right;
                                ">
                                    Approved Expenses
                                </td>

                                <td style="
                                    padding: 2px 5px;
                                    text-align: right;
                                ">

                                    <span class="money">
                                        <span class="rupee-symbol"></span>
                                        <span t-out="'%.2f' % data['travel_total']"/>
                                    </span>

                                </td>

                            </tr>


                            <!-- TOTAL -->

                            <tr style="
                                background: #e9ecef;
                                font-weight: bold;
                                border-top: 1.5px solid #1f3c5b;
                            ">

                                <td colspan="2"
                                    style="padding: 3px 5px;">

                                    Total Employee Expenses

                                </td>

                                <td style="
                                    padding: 3px 5px;
                                    text-align: right;
                                ">

                                    <span class="money">
                                        <span class="rupee-symbol"></span>
                                        <span t-out="'%.2f' % data['total_expense']"/>
                                    </span>

                                </td>

                            </tr>

                        </tbody>

                    </table>


                    <!-- =================================================
                         4. EXPENSE DETAILS
                    ================================================== -->

                    <h3 class="section-title">
                        Expense Details
                    </h3>


                    <table style="
                        width: 100%;
                        border-collapse: collapse;
                        margin: 0 0 5px 0;
                    ">

                        <thead>

                            <tr style="
                                background: #1f3c5b;
                                color: #ffffff;
                            ">

                                <th style="
                                    padding: 3px 5px;
                                    text-align: left;
                                ">
                                    Date
                                </th>

                                <th style="
                                    padding: 3px 5px;
                                    text-align: left;
                                ">
                                    Expense Reference
                                </th>

                                <th style="
                                    padding: 3px 5px;
                                    text-align: right;
                                ">
                                    Food Expense
                                </th>

                                <th style="
                                    padding: 3px 5px;
                                    text-align: right;
                                ">
                                    Travel Expense
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            <t t-foreach="data['expenses']" t-as="row">

                                <tr style="
                                    border-bottom: 1px solid #dee2e6;
                                ">

                                    <td style="padding: 2px 5px;">

                                        <span t-out="row['date']"
                                              t-options='{"widget": "date"}'/>

                                    </td>


                                    <td style="padding: 2px 5px;">

                                        <span t-out="row['reference']"/>

                                    </td>


                                    <td style="
                                        padding: 2px 5px;
                                        text-align: right;
                                    ">

                                        <span class="money">
                                            <span class="rupee-symbol"></span>
                                            <span t-out="'%.2f' % row['food']"/>
                                        </span>

                                    </td>


                                    <td style="
                                        padding: 2px 5px;
                                        text-align: right;
                                    ">

                                        <span class="money">
                                            <span class="rupee-symbol"></span>
                                            <span t-out="'%.2f' % row['travel']"/>
                                        </span>

                                    </td>

                                </tr>

                            </t>


                            <tr t-if="not data['expenses']">

                                <td colspan="4"
                                    style="
                                        padding: 4px;
                                        text-align: center;
                                        color: #6c757d;
                                    ">

                                    No approved food / travel expenses
                                    in this period.

                                </td>

                            </tr>


                            <tr style="
                                background: #f1f3f5;
                                font-weight: bold;
                            ">

                                <td colspan="2"
                                    style="padding: 3px 5px;">

                                    Total

                                </td>


                                <td style="
                                    padding: 3px 5px;
                                    text-align: right;
                                ">

                                    <span class="money">
                                        <span class="rupee-symbol"></span>
                                        <span t-out="'%.2f' % data['food_total']"/>
                                    </span>

                                </td>


                                <td style="
                                    padding: 3px 5px;
                                    text-align: right;
                                ">

                                    <span class="money">
                                        <span class="rupee-symbol"></span>
                                        <span t-out="'%.2f' % data['travel_total']"/>
                                    </span>

                                </td>

                            </tr>

                        </tbody>

                    </table>


                    <!-- =================================================
                         5. FINAL PROFIT / LOSS
                    ================================================== -->

                    <div style="
                        border: 1.5px solid #1f3c5b;
                        margin-top: 3px;
                        page-break-inside: avoid;
                    ">


                        <div style="
                            background: #1f3c5b;
                            color: #ffffff;
                            padding: 4px 7px;
                            font-size: 11px;
                            font-weight: bold;
                        ">
                            Final Profit / Loss
                        </div>


                        <table style="
                            width: 100%;
                            border-collapse: collapse;
                        ">


                            <!-- GROSS MARGIN -->

                            <tr>

                                <td style="padding: 3px 7px;">
                                    Gross Margin
                                </td>

                                <td style="
                                    padding: 3px 7px;
                                    text-align: right;
                                ">

                                    <span class="money">
                                        <span class="rupee-symbol"></span>
                                        <span t-out="'%.2f' % data['total_margin']"/>
                                    </span>

                                </td>

                            </tr>


                            <!-- EXPENSE -->

                            <tr style="background: #f8f9fa;">

                                <td style="padding: 3px 7px;">
                                    Less: Total Employee Expenses
                                </td>

                                <td style="
                                    padding: 3px 7px;
                                    text-align: right;
                                ">

                                    -

                                    <span class="money">
                                        <span class="rupee-symbol"></span>
                                        <span t-out="'%.2f' % data['total_expense']"/>
                                    </span>

                                </td>

                            </tr>


                            <!-- FINAL RESULT -->

                            <tr style="
                                font-size: 12px;
                                font-weight: bold;
                                background: #f8f9fa;
                            ">

                                <td style="padding: 4px 7px;">

                                    <t t-if="data['net_profit'] >= 0">

                                        <strong style="color: #198754;">
                                            NET PROFIT
                                        </strong>

                                    </t>

                                    <t t-else="">

                                        <strong style="color: #dc3545;">
                                            NET LOSS
                                        </strong>

                                    </t>

                                </td>


                                <td style="
                                    padding: 4px 7px;
                                    text-align: right;
                                ">

                                    <strong t-if="data['net_profit'] >= 0"
                                            style="color: #198754;">

                                        <span class="money">
                                            <span class="rupee-symbol"></span>
                                            <span t-out="'%.2f' % data['net_profit']"/>
                                        </span>

                                    </strong>


                                    <strong t-else=""
                                            style="color: #dc3545;">

                                        <span class="money">
                                            <span class="rupee-symbol"></span>
                                            <span t-out="'%.2f' % data['net_profit']"/>
                                        </span>

                                    </strong>

                                </td>

                            </tr>

                        </table>

                    </div>


                    <!-- =================================================
                         FOOTER
                    ================================================== -->

                    <div style="
                        margin-top: 3px;
                        padding: 0;
                        font-size: 7px;
                        color: #6c757d;
                        text-align: center;
                    ">

                        This report is generated from the Field Salesperson
                        reporting system.

                    </div>


                </div>

            </t>

        </t>

    </template>

</odoo>
