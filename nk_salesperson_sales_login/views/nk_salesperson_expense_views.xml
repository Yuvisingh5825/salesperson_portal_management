<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         EXPENSE FORM VIEW
    ========================================================== -->

    <record id="view_nk_salesperson_expense_form" model="ir.ui.view">
        <field name="name">nk.salesperson.expense.form</field>
        <field name="model">nk.salesperson.expense</field>
        <field name="arch" type="xml">

            <form string="Salesperson Expense">

                <!-- =================================================
                     HEADER
                ================================================== -->

                <header>

                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ('draft', 'rejected')"/>

                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-success"
                            groups="nk_salesperson_sales_login.group_nk_salesperson_manager,base.group_system"
                            invisible="state != 'submitted'"/>

                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"
                            groups="nk_salesperson_sales_login.group_nk_salesperson_manager,base.group_system"
                            invisible="state != 'submitted'"/>

                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            class="btn-secondary"
                            groups="nk_salesperson_sales_login.group_nk_salesperson_manager,base.group_system"
                            invisible="state not in ('rejected', 'approved')"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,submitted,approved,rejected"/>

                </header>


                <!-- =================================================
                     SHEET
                ================================================== -->

                <sheet>

                    <!-- =================================================
                         EXPENSE REFERENCE
                    ================================================== -->

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>


                    <!-- =================================================
                         BASIC INFORMATION
                    ================================================== -->

                    <separator string="Expense Information"/>

                    <group>

                        <group>

                            <field name="employee_id"
                                   options="{'no_create': True}"/>

                            <field name="expense_date"/>

                        </group>

                        <group>

                            <field name="company_id"
                                   options="{'no_create': True}"/>

                            <field name="currency_id"
                                   options="{'no_create': True}"/>

                        </group>

                    </group>


                    <!-- =================================================
                         EXPENSE AMOUNTS
                    ================================================== -->

                    <separator string="Expense Details"/>

                    <group>

                        <group string="Expense Amounts">

                            <field name="travel_amount"
                                   string="Travel"/>

                            <field name="food_amount"
                                   string="Food"/>

                            <field name="hotel_amount"
                                   string="Hotel"/>

                        </group>

                        <group string="Expense Amounts">

                            <field name="fuel_amount"
                                   string="Fuel"/>

                            <field name="mobile_amount"
                                   string="Mobile"/>

                            <field name="other_amount"
                                   string="Other"/>

                        </group>

                    </group>


                    <!-- =================================================
                         TOTAL EXPENSE
                    ================================================== -->

                    <group class="oe_right">

                        <field name="total_expense"
                               string="Total Expense"
                               readonly="1"
                               class="oe_inline"/>

                    </group>


                    <!-- =================================================
                         LOCATION
                    ================================================== -->

                    <separator string="Location Details"/>

                    <group>

                        <group>

                            <field name="location"
                                   required="1"/>

                            <field name="address"/>

                        </group>

                        <group>

                            <field name="latitude"/>

                            <field name="longitude"/>

                        </group>

                    </group>


                    <!-- =================================================
                         DESCRIPTION & RECEIPT
                    ================================================== -->

                    <separator string="Description &amp; Receipt"/>

                    <group>

                        <field name="description"
                               placeholder="Enter expense details..."/>

                        <field name="receipt"
                               filename="receipt_filename"/>

                        <field name="receipt_filename"
                               invisible="1"/>

                    </group>


                    <!-- =================================================
                         REJECTION INFORMATION
                    ================================================== -->

                    <separator string="Rejection Information"/>

                    <group invisible="state != 'rejected'">

                        <field name="rejection_reason"
                               placeholder="Enter rejection reason..."/>

                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- =========================================================
         TREE VIEW
    ========================================================== -->

    <record id="view_nk_salesperson_expense_tree" model="ir.ui.view">
        <field name="name">nk.salesperson.expense.tree</field>
        <field name="model">nk.salesperson.expense</field>
        <field name="arch" type="xml">

            <list string="Salesperson Expenses">

                <field name="name"/>

                <field name="expense_date"/>

                <field name="employee_id"/>

                <field name="location"/>

                <field name="travel_amount"
                       optional="hide"/>

                <field name="food_amount"
                       optional="hide"/>

                <field name="hotel_amount"
                       optional="hide"/>

                <field name="fuel_amount"
                       optional="hide"/>

                <field name="mobile_amount"
                       optional="hide"/>

                <field name="other_amount"
                       optional="hide"/>

                <field name="total_expense"/>

                <field name="currency_id"
                       optional="hide"/>

                <field name="state"
                       widget="badge"/>

            </list>

        </field>
    </record>


    <!-- =========================================================
         SEARCH VIEW
    ========================================================== -->

    <record id="view_nk_salesperson_expense_search" model="ir.ui.view">
        <field name="name">nk.salesperson.expense.search</field>
        <field name="model">nk.salesperson.expense</field>
        <field name="arch" type="xml">

            <search string="Search Expenses">

                <field name="name"/>

                <field name="employee_id"/>

                <field name="expense_date"/>

                <field name="state"/>

                <field name="location"/>

                <separator/>

                <!-- =================================================
                     STATUS FILTERS
                ================================================== -->

                <filter name="filter_draft"
                        string="Draft"
                        domain="[('state', '=', 'draft')]"/>

                <filter name="filter_submitted"
                        string="Pending Approval"
                        domain="[('state', '=', 'submitted')]"/>

                <filter name="filter_approved"
                        string="Approved"
                        domain="[('state', '=', 'approved')]"/>

                <filter name="filter_rejected"
                        string="Rejected"
                        domain="[('state', '=', 'rejected')]"/>

                <separator/>

                <!-- =================================================
                     GROUP BY
                ================================================== -->

                <group>

                    <filter name="group_employee"
                            string="Salesperson"
                            context="{'group_by': 'employee_id'}"/>

                    <filter name="group_state"
                            string="Status"
                            context="{'group_by': 'state'}"/>

                    <filter name="group_date"
                            string="Expense Date"
                            context="{'group_by': 'expense_date'}"/>

                    <filter name="group_company"
                            string="Company"
                            context="{'group_by': 'company_id'}"/>

                    <filter name="group_location"
                            string="Location"
                            context="{'group_by': 'location'}"/>

                </group>

            </search>

        </field>
    </record>


    <!-- =========================================================
         EXPENSE ACTION
    ========================================================== -->

    <record id="action_nk_salesperson_expense" model="ir.actions.act_window">

        <field name="name">Expenses</field>

        <field name="res_model">nk.salesperson.expense</field>

        <field name="view_mode">list,form</field>

        <field name="search_view_id"
               ref="view_nk_salesperson_expense_search"/>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first salesperson expense.
            </p>

            <p>
                Record travel, food, hotel, fuel, mobile and other
                expenses in a single location-based expense record.
            </p>

        </field>

    </record>


    <!-- =========================================================
         PIVOT REPORT
    ========================================================== -->

    <record id="view_nk_salesperson_expense_pivot" model="ir.ui.view">
        <field name="name">nk.salesperson.expense.pivot</field>
        <field name="model">nk.salesperson.expense</field>
        <field name="arch" type="xml">

            <pivot string="Expense Analysis">

                <field name="employee_id"
                       type="row"/>

                <field name="location"
                       type="row"/>

                <field name="expense_date"
                       type="col"
                       interval="month"/>

                <field name="travel_amount"
                       type="measure"/>

                <field name="food_amount"
                       type="measure"/>

                <field name="hotel_amount"
                       type="measure"/>

                <field name="fuel_amount"
                       type="measure"/>

                <field name="mobile_amount"
                       type="measure"/>

                <field name="other_amount"
                       type="measure"/>

                <field name="total_expense"
                       type="measure"/>

            </pivot>

        </field>
    </record>


    <!-- =========================================================
         GRAPH REPORT
    ========================================================== -->

    <record id="view_nk_salesperson_expense_graph" model="ir.ui.view">
        <field name="name">nk.salesperson.expense.graph</field>
        <field name="model">nk.salesperson.expense</field>
        <field name="arch" type="xml">

            <graph string="Expense Analysis"
                   type="bar">

                <field name="employee_id"
                       type="row"/>

                <field name="total_expense"
                       type="measure"/>

            </graph>

        </field>
    </record>


    <!-- =========================================================
         EXPENSE LOCATION WISE REPORT  (opened from the reporting wizard)
    ========================================================== -->

    <record id="view_nk_expense_location_graph" model="ir.ui.view">
        <field name="name">nk.salesperson.expense.location.graph</field>
        <field name="model">nk.salesperson.expense</field>
        <field name="arch" type="xml">
            <graph string="Expense by Location" type="bar">
                <field name="location"/>
                <field name="total_expense" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_nk_expense_location_pivot" model="ir.ui.view">
        <field name="name">nk.salesperson.expense.location.pivot</field>
        <field name="model">nk.salesperson.expense</field>
        <field name="arch" type="xml">
            <pivot string="Expense by Location">
                <field name="location" type="row"/>
                <field name="travel_amount" type="measure"/>
                <field name="food_amount" type="measure"/>
                <field name="hotel_amount" type="measure"/>
                <field name="fuel_amount" type="measure"/>
                <field name="mobile_amount" type="measure"/>
                <field name="other_amount" type="measure"/>
                <field name="total_expense" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_nk_expense_location_list" model="ir.ui.view">
        <field name="name">nk.salesperson.expense.location.list</field>
        <field name="model">nk.salesperson.expense</field>
        <field name="arch" type="xml">
            <list string="Expense by Location">
                <field name="location"/>
                <field name="expense_date"/>
                <field name="employee_id"/>
                <field name="address" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="travel_amount" sum="Total"/>
                <field name="food_amount" sum="Total"/>
                <field name="hotel_amount" sum="Total"/>
                <field name="fuel_amount" sum="Total"/>
                <field name="mobile_amount" sum="Total"/>
                <field name="other_amount" sum="Total"/>
                <field name="total_expense" sum="Total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_nk_report_expense_location" model="ir.actions.act_window">
        <field name="name">Expense Location Wise</field>
        <field name="res_model">nk.salesperson.expense</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_nk_expense_location_graph')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_nk_expense_location_pivot')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_nk_expense_location_list')})]"/>
        <field name="search_view_id" ref="view_nk_salesperson_expense_search"/>
        <field name="context">{'search_default_group_location': 1}</field>
    </record>


    <!-- =========================================================
         SALES PERSON EXPENSE MENU
    ========================================================== -->

    <menuitem
        id="menu_nk_salesperson_expense"
        name="Field Salesperson Expenses"
        parent="menu_nk_salesperson_reporting_root"
        action="action_nk_salesperson_expense"
        sequence="55"
        groups="sales_team.group_sale_manager,nk_salesperson_sales_login.group_nk_salesperson_manager,base.group_system"
    />

</odoo>
