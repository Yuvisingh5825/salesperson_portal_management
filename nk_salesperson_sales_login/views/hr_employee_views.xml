<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_nk_salesperson" model="ir.ui.view">
        <field name="name">hr.employee.form.nk.salesperson</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='hr_settings']//group[@name='settings_group']"
                   position="inside">
                <group string="Field Salesperson Login" name="nk_salesperson_login">
                    <field name="nk_employee_id" placeholder="Example: EMP001"/>
                    <field name="nk_password" password="True"
                           groups="hr.group_hr_manager"/>
                    <field name="nk_salary" groups="hr.group_hr_manager"/>
                    <field name="nk_mobile_expense" groups="hr.group_hr_manager"/>
                    <field name="nk_currency_id" invisible="1"/>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
