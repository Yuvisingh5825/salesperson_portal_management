<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- =====================================================
         FIELD SALESPERSON
         Actual employee filtering is handled in sale_order.py
    ====================================================== -->

    <record id="rule_nk_salesperson_quotation_only"
            model="ir.rule">

        <field name="name">
            Salesperson - Own Quotations
        </field>

        <field name="model_id"
               ref="sale.model_sale_order"/>

        <field name="groups"
               eval="[(4, ref('group_nk_salesperson'))]"/>

        <field name="domain_force">
            [(1, '=', 1)]
        </field>

        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>

    </record>


    <!-- =====================================================
         FIELD SALESPERSON MANAGER
         Manager can see ALL quotations
    ====================================================== -->

    <record id="rule_nk_salesperson_manager_all"
            model="ir.rule">

        <field name="name">
             Salesperson Manager - All Quotations
        </field>

        <field name="model_id"
               ref="sale.model_sale_order"/>

        <field name="groups"
               eval="[(4, ref('group_nk_salesperson_manager'))]"/>

        <field name="domain_force">
            [(1, '=', 1)]
        </field>

        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>

    </record>


    <!-- =====================================================
         FIELD SALESPERSON
         OWN TRAVEL / FOOD EXPENSES
    ====================================================== -->

    <record id="rule_nk_salesperson_expense_own"
            model="ir.rule">

        <field name="name">
            Field Salesperson - Own Expenses
        </field>

        <field name="model_id"
               ref="model_nk_salesperson_expense"/>

        <field name="groups"
               eval="[(4, ref('group_nk_salesperson'))]"/>

        <!--
            Salesperson can see only expenses
            belonging to his/her employee record.
        -->

        <field name="domain_force">
            [('employee_id.user_id', '=', user.id)]
        </field>

        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>

    </record>


    <!-- =====================================================
         FIELD SALESPERSON MANAGER
         ALL TRAVEL / FOOD EXPENSES
    ====================================================== -->

    <record id="rule_nk_salesperson_expense_manager_all"
            model="ir.rule">

        <field name="name">
            Field Salesperson Manager - All Expenses
        </field>

        <field name="model_id"
               ref="model_nk_salesperson_expense"/>

        <field name="groups"
               eval="[(4, ref('group_nk_salesperson_manager'))]"/>

        <field name="domain_force">
            [(1, '=', 1)]
        </field>

        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>

    </record>

</odoo>
